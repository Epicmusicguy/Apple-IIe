100 HOME
110 PRINT "   APPLE IIE WIKIPEDIA"
120 PRINT "   ==================="
130 PRINT ""
140 PRINT "LOADING ARTICLE DATABASE..."
150 REM INITIALIZE ARRAYS
160 DIM AS(100),CS(20),KS(500)
170 DIM AC(100),AO(100),AD(500)
180 PRINT "READY"
190 PRINT ""
200 GOSUB 5000
210 PRINT "GOODBYE"
220 END
230 REM
240 REM MAIN MENU ROUTINE
5000 HOME
5010 PRINT "MAIN MENU:"
5020 PRINT ""
5030 PRINT "1. SEARCH ARTICLES"
5040 PRINT "2. BROWSE BY CATEGORY"
5050 PRINT "3. VIEW ARTICLE INDEX"
5060 PRINT "4. HELP"
5070 PRINT "5. EXIT"
5080 PRINT ""
5090 INPUT "SELECT (1-5): "; C
5100 ON C GOSUB 6000,7000,8000,9000,5200
5110 GOTO 5000
5200 RETURN
5210 REM
5220 REM SEARCH ROUTINE
6000 HOME
6010 PRINT "SEARCH ARTICLES"
6020 PRINT ""
6030 INPUT "ENTER SEARCH TERM: "; ST$
6040 IF ST$ = "" THEN RETURN
6050 PRINT "SEARCHING..."
6060 PRINT "ARTICLES FOUND: 0"
6070 PRINT ""
6080 PRINT "PRESS ANY KEY"
6090 GET K$
6100 RETURN
6110 REM
6120 REM CATEGORY BROWSE ROUTINE
7000 HOME
7010 PRINT "CATEGORIES:"
7020 PRINT "1. HISTORY"
7030 PRINT "2. SCIENCE"
7040 PRINT "3. TECHNOLOGY"
7050 PRINT "4. BACK"
7060 PRINT ""
7070 INPUT "SELECT: "; CAT
7080 IF CAT = 4 THEN RETURN
7090 PRINT "LOADING CATEGORY..."
7100 PRINT ""
7110 PRINT "PRESS ANY KEY"
7120 GET K$
7130 RETURN
7140 REM
7150 REM INDEX ROUTINE
8000 HOME
8010 PRINT "ARTICLE INDEX"
8020 PRINT ""
8030 PRINT "1. APPLE COMPUTER"
8040 PRINT "2. DOS 3.3"
8050 PRINT "3. BASIC"
8060 PRINT ""
8070 PRINT "PRESS ANY KEY"
8080 GET K$
8090 RETURN
8100 REM
8110 REM HELP ROUTINE
9000 HOME
9010 PRINT "APPLE IIE WIKIPEDIA HELP"
9020 PRINT ""
9030 PRINT "USE MENUS TO:"
9040 PRINT "- SEARCH ARTICLES"
9050 PRINT "- BROWSE BY TOPIC"
9060 PRINT "- VIEW ALL ARTICLES"
9070 PRINT ""
9080 PRINT "PRESS ANY KEY"
9090 GET K$
9100 RETURN
