100 REM APPLE IIE WIKIPEDIA APPLICATION
110 REM FOR DOS 3.3
120 REM ================================
130 PRINT CHR$(4)"BLOAD WIKI.ML,A$6000"
140 DIM AS(100),CS(20),KS(500)
150 DIM AC(100),AO(100),AD(500)
160 HOME
170 PRINT "   APPLE IIE WIKIPEDIA"
180 PRINT "   ==================="
190 PRINT ""
200 GOSUB 5000
210 END
220 REM
230 REM MAIN MENU ROUTINE
5000 HOME
5010 PRINT "MAIN MENU:"
5020 PRINT ""
5030 PRINT "1. SEARCH ARTICLES"
5040 PRINT "2. BROWSE BY CATEGORY"
5050 PRINT "3. VIEW ARTICLE INDEX"
5060 PRINT "4. RANDOM ARTICLE"
5070 PRINT "5. HELP"
5080 PRINT "6. EXIT"
5090 PRINT ""
5100 INPUT "SELECT (1-6): "; C
5110 IF C = 1 THEN GOSUB 6000
5120 IF C = 2 THEN GOSUB 7000
5130 IF C = 3 THEN GOSUB 8000
5140 IF C = 4 THEN GOSUB 9000
5150 IF C = 5 THEN GOSUB 10000
5160 IF C = 6 THEN END
5170 GOTO 5000
5180 REM
5190 REM SEARCH ROUTINE
6000 HOME
6010 PRINT "SEARCH ARTICLES"
6020 PRINT ""
6030 INPUT "ENTER SEARCH TERM: "; ST
6040 IF ST = "" THEN RETURN
6050 PRINT "SEARCHING..."
6060 REM SEARCH LOGIC WOULD GO HERE
6070 PRINT "SEARCH COMPLETE - PRESS SPACE"
6080 GET K
6090 RETURN
6100 REM
6110 REM CATEGORY BROWSE ROUTINE
7000 HOME
7010 PRINT "CATEGORIES:"
7020 PRINT "1. HISTORY"
7030 PRINT "2. SCIENCE"
7040 PRINT "3. TECHNOLOGY"
7050 PRINT "4. ARTS"
7060 PRINT "5. BACK"
7070 INPUT "SELECT: "; CAT
7080 IF CAT = 5 THEN RETURN
7090 PRINT "LOADING CATEGORY..."
7100 REM CATEGORY LOGIC HERE
7110 RETURN
7120 REM
7130 REM INDEX ROUTINE
8000 HOME
8010 PRINT "ARTICLE INDEX"
8020 PRINT ""
8030 REM INDEX DISPLAY HERE
8040 RETURN
8050 REM
8060 REM RANDOM ARTICLE ROUTINE
9000 HOME
9010 PRINT "LOADING RANDOM ARTICLE..."
9020 REM RANDOM SELECTION LOGIC
9030 RETURN
9040 REM
9050 REM HELP ROUTINE
10000 HOME
10010 PRINT "APPLE IIE WIKIPEDIA HELP"
10020 PRINT ""
10030 PRINT "USE THE MENUS TO:"
10040 PRINT "- SEARCH FOR TOPICS"
10050 PRINT "- BROWSE CATEGORIES"
10060 PRINT "- VIEW COMPLETE INDEX"
10070 PRINT ""
10080 PRINT "PRESS SPACE FOR MORE"
10090 GET K
10100 RETURN